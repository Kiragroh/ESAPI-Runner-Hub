<Window x:Class="EsapiRunnerHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESAPI Runner Hub" Height="820" Width="1320" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="#F4F1EA" FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/ESAPI-Runner-Hub.png">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="Ink" Color="#17243A" />
        <SolidColorBrush x:Key="Muted" Color="#697386" />
        <SolidColorBrush x:Key="Teal" Color="#087F76" />
        <SolidColorBrush x:Key="Navy" Color="#14243C" />
        <SolidColorBrush x:Key="Cream" Color="#F4F1EA" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Teal}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.34" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E7ECEB" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7D9D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="168" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Navy}" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/ESAPI-Runner-Hub.png" Width="44" Height="44" Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock Text="ESAPI Runner Hub" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="One patient context · independent application processes" Foreground="#AFC1D8" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#203955" CornerRadius="16" Padding="13,7" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#54C6B8" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EsapiStatusText}" Foreground="#E7F1F5" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Content="Settings" Click="Settings_Click" Style="{StaticResource SecondaryButton}" Padding="14,8" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="164" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E0DA" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Patient context" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Search once, then start several tools for the same patient." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />
                    <TextBox Grid.Row="2" Style="{StaticResource Input}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Patient ID or name" />
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <ListBox ItemsSource="{Binding Suggestions}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectPatientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="8" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Select patient" FontSize="11" Foreground="{StaticResource Teal}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Background="#EAF4F1" CornerRadius="8" Padding="14" VerticalAlignment="Top"
                                Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="SELECTED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Teal}" />
                                <TextBlock Text="{Binding SelectedPatientDisplay}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,10" TextWrapping="Wrap" />
                                <Button Content="Clear patient" Command="{Binding ClearPatientCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="4" BorderBrush="#E6E3DC" BorderThickness="0,1,0,0" Padding="0,13,0,0">
                        <TextBlock Text="Privacy: the patient selection remains in memory only. Names, IDs, and search text are not written to Hub logs." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="14,0" Background="#E8E5DE" CornerRadius="10" Padding="12,18">
                <StackPanel>
                    <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="8,0,8,10" />
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Navy}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="270" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Application catalogue" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Each application starts in its own process; a child error does not close the Hub." Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Style="{StaticResource Input}" Text="{Binding ApplicationFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter applications" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VisibleApplications}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="340" MinHeight="204" Background="White" CornerRadius="10" BorderBrush="#E0DED8" BorderThickness="1" Margin="0,0,12,12" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="Bold" />
                                            <Border Grid.Column="1" Background="#F0EEE8" CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="{Binding ModeLabel}" FontSize="10" Foreground="{StaticResource Muted}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4" />
                                        <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,11">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#CB6D51" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Fill" Value="#299A78" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                        <WrapPanel Grid.Row="4">
                                            <Button Content="{Binding WithPatientLabel}" Command="{Binding DataContext.StartWithPatientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanStartWithPatient}" Visibility="{Binding WithPatientVisibility}"
                                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                            <Button Content="{Binding WithoutPatientLabel}" Command="{Binding DataContext.StartWithoutPatientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanStartWithoutPatient}" Visibility="{Binding WithoutPatientVisibility}"
                                                    Style="{StaticResource SecondaryButton}" />
                                            <TextBlock Text="{Binding ReferenceHint}" Visibility="{Binding ReferenceVisibility}" Foreground="#7A5B18"
                                                       Background="#FFF1C9" Padding="10,7" FontWeight="SemiBold" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FFFDF8" BorderBrush="#DDD9D0" BorderThickness="0,1,0,0" Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Process activity" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NotificationText}" Foreground="{StaticResource Muted}" Margin="0,6,20,0" TextWrapping="Wrap" />
                </StackPanel>
                <ListView Grid.Column="1" ItemsSource="{Binding Processes}" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Application" DisplayMemberBinding="{Binding ApplicationName}" Width="220" />
                            <GridViewColumn Header="PID" DisplayMemberBinding="{Binding ProcessId}" Width="70" />
                            <GridViewColumn Header="Started" DisplayMemberBinding="{Binding Started}" Width="90" />
                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="160" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
